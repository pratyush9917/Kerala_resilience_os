# Kerala Resilience OS - Environment Template
# Copy this file to .env and insert your private API keys

# Carto Basemaps API Key (Optional/Recommended for higher rate limits)
CARTO_API_KEY=your_carto_api_key_here

PORT=8000
HOST=127.0.0.1

# Groq AI advisor - paste your key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional: model override (default openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b
